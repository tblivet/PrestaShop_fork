{
  "variable": "orderGrid",
  "id": "order",
  "name": "Orders",
  "form_prefix": "order",
  "action": "/sell/orders/filter",
  "reset_url": "/common/reset_search/order",
  "redirect_url": "/sell/orders",
  "columns": [
    {
      "id": "orders_bulk",
      "name": "",
      "type": "bulk_action",
      "options": {
        "bulk_field": "id_order",
        "disabled_field": null,
        "sortable": false
      }
    },
    {
      "id": "id_order",
      "name": "ID",
      "type": "identifier",
      "options": {
        "identifier_field": "id_order",
        "sortable": true
      }
    },
    {
      "id": "reference",
      "name": "Reference",
      "type": "data",
      "options": {
        "field": "reference",
        "sortable": true,
        "max_displayed_characters": 0
      }
    },
    {
      "id": "new",
      "name": "New client",
      "type": "boolean",
      "options": {
        "field": "new",
        "true_name": "Yes",
        "false_name": "No",
        "sortable": false
      }
    },
    {
      "id": "customer",
      "name": "Customer",
      "type": "data",
      "options": {
        "field": "customer",
        "sortable": true,
        "max_displayed_characters": 20
      }
    },
    {
      "id": "total_paid_tax_incl",
      "name": "Total",
      "type": "order_price",
      "options": {
        "field": "total_paid_tax_incl",
        "is_paid_field": "paid",
        "sortable": true,
        "alignment": "right"
      }
    },
    {
      "id": "osname",
      "name": "Status",
      "type": "badge",
      "options": {
        "field": "osname",
        "color_field": "color",
        "sortable": true
      }
    },
    {
      "id": "date_add",
      "name": "Date",
      "type": "date_time",
      "options": {
        "format": "Y-m-d H:i",
        "sortable": true,
        "empty_data": ""
      }
    }
  ],
  "filters": [
    {
      "name": "id_order",
      "column": "id_order",
      "type": "text"
    },
    {
      "name": "reference",
      "column": "reference",
      "type": "text"
    },
    {
      "name": "customer",
      "column": "customer",
      "type": "text"
    },
    {
      "name": "total_paid_tax_incl",
      "column": "total_paid_tax_incl",
      "type": "number_min_max"
    },
    {
      "name": "date_add",
      "column": "date_add",
      "type": "date_range",
      "options": {
        "default_end_value": "2026-11-25"
      }
    }
  ],
