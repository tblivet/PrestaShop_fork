{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block stylesheets %}
  {{ parent() }}
  {% if not ui_kit %}
    <link rel="stylesheet" href="{{ asset('themes/new-theme/public/orders' ~ rtl_suffix ~ '.css') }}" type="text/css" media="all">
  {% endif %}
{% endblock %}

{% block content %}
  {# With PS_UI_KIT on, Ui/index.html.twig renders the page and the blocks below are not used #}
  {% if ui_kit %}
    {{ include('@PrestaShop/Admin/Sell/Order/Order/Ui/index.html.twig') }}
  {% else %}
  {{ include('@PrestaShop/Admin/Sell/Order/Order/Blocks/change_orders_status_modal.html.twig') }}

  {% block orders_kpi %}
    {{ render(controller(
      'PrestaShopBundle\\Controller\\Admin\\CommonController::renderKpiRowAction',
      {kpiRow: orderKpi},
    )) }}
  {% endblock %}

  {% block order_grid_row %}
    {{ include('@PrestaShop/Admin/Common/Grid/grid_panel.html.twig', {grid: orderGrid}) }}
  {% endblock %}
  {% endif %}
{% endblock %}

{% block javascripts %}
  {{ parent() }}

  {% if ui_kit %}
    <script src="{{ asset('themes/new-theme/public/order_ui.bundle.js') }}"></script>
  {% else %}
    <script src="{{ asset('themes/default/js/bundle/pagination.js') }}"></script>
    <script src="{{ asset('themes/new-theme/public/order.bundle.js') }}"></script>
  {% endif %}
{% endblock %}
