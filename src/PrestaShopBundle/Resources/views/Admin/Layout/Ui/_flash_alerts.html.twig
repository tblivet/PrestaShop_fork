{# Flash messages of the login pages, printed once: the flash bag is emptied when read #}
{% set alerts = {
  error: {type: 'danger', icon: 'bi:x-circle-fill'},
  failure: {type: 'danger', icon: 'bi:x-circle-fill'},
  success: {type: 'success', icon: 'bi:check-circle-fill'},
  warning: {type: 'warning', icon: 'bi:exclamation-triangle-fill'},
  info: {type: 'info', icon: 'bi:info-circle-fill'},
} %}

{% for flashType, alert in alerts %}
  {% set messages = app.session.flashbag.get(flashType) %}
  {% if messages is not empty %}
    <twig:ui:Alert :type="alert.type" :icon="alert.icon" dismissible>
      {% for message in messages %}
        <p class="mb-0">{{ message|raw_purified }}</p>
      {% endfor %}
    </twig:ui:Alert>
  {% endif %}
{% endfor %}
