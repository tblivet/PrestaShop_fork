{# Login, reset password and required actions pages with the /ui kit (PS_UI_KIT on) #}
<!DOCTYPE html>
<html lang="{{ ps.isoUser }}"{% if ps.isRtlLanguage %} dir="rtl"{% endif %}>
<head>
  {# The page's own title, then the shop (DECISIONS.md #32): each page fills login_title with its h1 text #}
  {{ component('LoginHeadTag', {metaTitle: (block('login_title') is defined ? block('login_title') : '')|trim}) }}
  {% block login_javascripts %}{% endblock %}
</head>

<body class="lang-{{ ps.isoUser }}">
  <main class="ps-page ps-page--bg-subtle ps-page--login ps-login">
    <a class="icon-link icon-link-hover small ps-login__back" href="{{ ps.baseUrl }}">
      <i class="material-symbols-outlined" aria-hidden="true">arrow_back</i>
      {{ 'Back to %store_name%'|trans({'%store_name%': shopName}, 'Admin.Actions') }}
    </a>

    <div class="ps-login__container">
      <div class="card ps-login__card">
        <div class="card-body ps-login__card-body">
          <div class="ps-login__logo-big text-center">
            <img class="img-fluid" src="{{ asset('prestashop.svg', 'ui_kit') }}" alt="PrestaShop" width="185" height="20" />
          </div>

          {% block login_content %}{% endblock %}
        </div>
      </div>

      {{ renderhook('displayAdminLogin') }}

      <div class="ps-login__copyright small text-center">
        <a class="link-secondary ps-login__copyright-link" href="https://www.prestashop-project.org" target="_blank" rel="noopener noreferrer">
          {{ '© %brand% 2007-%year% - All rights reserved'|trans({'%brand%': 'PrestaShop™', '%year%': 'now'|date('Y')}, 'Admin.Login.Feature') }}
        </a>
      </div>

      <div class="ps-login__social d-flex gap-1 align-items-center justify-content-center mt-4">
        <a href="https://x.com/PrestaShop" class="link-secondary d-flex align-items-center justify-content-center ps-login__social-link" target="_blank" rel="noopener noreferrer" aria-label="{{ '%brand% on %network%'|trans({'%brand%': 'PrestaShop', '%network%': 'X'}, 'Admin.Login.Feature') }}">
          <twig:ux:icon name="bi:twitter-x" height="16" width="16" aria-hidden="true"/>
        </a>
        <a href="https://www.facebook.com/prestashop" class="link-secondary d-flex align-items-center justify-content-center ps-login__social-link" target="_blank" rel="noopener noreferrer" aria-label="{{ '%brand% on %network%'|trans({'%brand%': 'PrestaShop', '%network%': 'Facebook'}, 'Admin.Login.Feature') }}">
          <twig:ux:icon name="bi:facebook" height="16" width="16" aria-hidden="true"/>
        </a>
        <a href="https://github.com/PrestaShop/PrestaShop" class="link-secondary d-flex align-items-center justify-content-center ps-login__social-link" target="_blank" rel="noopener noreferrer" aria-label="{{ '%brand% on %network%'|trans({'%brand%': 'PrestaShop', '%network%': 'GitHub'}, 'Admin.Login.Feature') }}">
          <twig:ux:icon name="bi:github" height="16" width="16" aria-hidden="true"/>
        </a>
      </div>
    </div>
  </main>
</body>
</html>
