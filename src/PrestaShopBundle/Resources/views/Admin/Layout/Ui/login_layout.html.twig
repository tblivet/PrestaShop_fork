{# Login, reset password and required actions pages with the /ui kit (PS_UI_KIT on) #}
<!DOCTYPE html>
<html lang="{{ ps.isoUser }}"{% if ps.isRtlLanguage %} dir="rtl"{% endif %}>
<head>
  {# The page's own title, then the shop (DECISIONS.md #32): each page fills login_title with its h1 text #}
  {{ component('LoginHeadTag', {metaTitle: (block('login_title') is defined ? block('login_title') : '')|trim}) }}
  {% block login_javascripts %}{% endblock %}
</head>

<body class="lang-{{ ps.isoUser }}">
  <main class="ps-page ps-page--bg-subtle ps-page--login ps-login">
    <twig:ui:Link href="{{ ps.baseUrl }}" back class="small ps-login__back">
      {{- 'Back to %store_name%'|trans({'%store_name%': shopName}, 'Admin.Actions') -}}
    </twig:ui:Link>

    {# Rendered here, not inside the component tags: a block written there would be the component's own block, which the
       pages could not override #}
    {% set loginContent %}{% block login_content %}{% endblock %}{% endset %}

    <twig:ui:Layout:Stack gap="xl" class="ps-login__container">
      <div class="card ps-login__card">
        <twig:ui:Layout:Stack class="card-body ps-login__card-body">
          <div class="ps-login__logo-big text-center">
            <img class="img-fluid" src="{{ asset('prestashop.svg', 'ui_kit') }}" alt="PrestaShop" width="185" height="20" />
          </div>

          {{ loginContent }}

          {# Modules' sign-in additions (single sign-on, notices) close the card; no wrapper when none, so no empty gap #}
          {% set moduleContent %}{{ renderhook('displayAdminLogin') }}{% endset %}
          {% if moduleContent|trim is not empty %}
            <div class="ps-login__modules border-top pt-4">{{ moduleContent }}</div>
          {% endif %}
        </twig:ui:Layout:Stack>
      </div>

      {# Copyright and social links read as one block, set apart from the card #}
      <twig:ui:Layout:Stack gap="lg" class="ps-login__footer">
        <div class="ps-login__copyright small text-center">
          <twig:ui:Link href="https://www.prestashop-project.org" external class="link-secondary ps-login__copyright-link">
            {{- '© %brand% 2007-%year% - All rights reserved'|trans({'%brand%': 'PrestaShop™', '%year%': 'now'|date('Y')}, 'Admin.Login.Feature') -}}
          </twig:ui:Link>
        </div>

        <twig:ui:Layout:Cluster gap="xs" justify="center" class="ps-login__social">
          <twig:ui:IconButton
            icon="brand:twitter-x"
            label="{{ '%brand% on %network%'|trans({'%brand%': 'PrestaShop', '%network%': 'X'}, 'Admin.Login.Feature') }}"
            variant="link"
            size="sm"
            href="https://x.com/PrestaShop"
            target="_blank"
            rel="noopener noreferrer"
            class="link-secondary"
          />

          <twig:ui:IconButton
            icon="brand:facebook"
            label="{{ '%brand% on %network%'|trans({'%brand%': 'PrestaShop', '%network%': 'Facebook'}, 'Admin.Login.Feature') }}"
            variant="link"
            size="sm"
            href="https://www.facebook.com/prestashop"
            target="_blank"
            rel="noopener noreferrer"
            class="link-secondary"
          />

          <twig:ui:IconButton
            icon="brand:github"
            label="{{ '%brand% on %network%'|trans({'%brand%': 'PrestaShop', '%network%': 'GitHub'}, 'Admin.Login.Feature') }}"
            variant="link"
            size="sm"
            href="https://github.com/PrestaShop/PrestaShop"
            target="_blank"
            rel="noopener noreferrer"
            class="link-secondary"
          />
        </twig:ui:Layout:Cluster>
      </twig:ui:Layout:Stack>
    </twig:ui:Layout:Stack>
  </main>

  {# What scripts tell screen readers (announcer.js), in the page from the start so it is announced #}
  <twig:ui:Announcer/>
</body>
</html>
