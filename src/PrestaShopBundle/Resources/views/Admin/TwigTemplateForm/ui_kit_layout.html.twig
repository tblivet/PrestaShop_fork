{# Form theme of the /ui kit pages, which render widgets one by one rather than with form_row #}
{% extends 'bootstrap_5_layout.html.twig' %}

{# Kit forms report their own errors, never the browser's bubbles (DECISIONS.md #30): ui/src/js/components/form-validation.ts
 # checks the fields that have a client error slot on submit #}
{%- block form_start -%}
  {%- set attr = attr|merge({
    novalidate: 'novalidate',
    'data-ps-action': ((attr['data-ps-action'] ?? '') ~ ' validate')|trim,
  }) -%}
  {{- parent() -}}
{%- endblock form_start -%}

{# The empty message slot of a field's client check, linked by aria-describedby (id_client_error). Words from the field's
 # data-required-message and data-invalid-message attributes, the same as its server constraints, or generic ones #}
{%- block client_error_slot -%}
  <div
    class="invalid-feedback"
    id="{{ id }}_client_error"
    role="status"
    data-ps-target="client-error"
    data-ps-data-required="{{ attr['data-required-message'] ?? 'This field is required.'|trans({}, 'Admin.Notifications.Error') }}"
    data-ps-data-invalid="{{ attr['data-invalid-message'] ?? 'Invalid email address.'|trans({}, 'Admin.Notifications.Error') }}"
  ></div>
{%- endblock client_error_slot -%}

{# Links the help and the errors to their field, and marks it invalid for screen readers #}
{%- block widget_attributes -%}
  {%- set describedBy = (attr['aria-describedby'] ?? '')|split(' ')|filter(describedById => describedById is not empty) -%}
  {%- if help is not empty and (id ~ '_help') not in describedBy -%}
    {%- set describedBy = describedBy|merge([id ~ '_help']) -%}
  {%- endif -%}
  {%- if errors|length > 0 -%}
    {%- set describedBy = describedBy|merge([id ~ '_error']) -%}
    {%- set attr = attr|merge({'aria-invalid': 'true'}) -%}
  {%- endif -%}
  {%- if describedBy is not empty -%}
    {%- set attr = attr|merge({'aria-describedby': describedBy|join(' ')}) -%}
  {%- endif -%}
  {{- parent() -}}
{%- endblock widget_attributes -%}

{# Every password field gets the show/hide button (DECISIONS.md #25: the block maps the field to a kit component) #}
{%- block password_widget -%}
  {%- set attr = attr|merge({'aria-describedby': ((attr['aria-describedby'] ?? '') ~ ' ' ~ id ~ '_client_error')|trim}) -%}
  {%- set input -%}{{- parent() -}}{%- endset -%}
  {%- set fieldLabel = null -%}
  {%- if label is not same as(false) -%}
    {%- set fieldLabel = label is empty ? name|humanize : (translation_domain is same as(false) ? label : label|trans(label_translation_parameters, translation_domain)) -%}
  {%- endif -%}
  <twig:ui:PasswordField :inputId="id" :label="fieldLabel">{{ input }}</twig:ui:PasswordField>
  {#- After the group, not in it: the kit shows it through .input-group:has(> [aria-invalid]) ~ .invalid-feedback -#}
  {{- block('client_error_slot') -}}
{%- endblock password_widget -%}

{# Every email field gets the client error slot: required and email format checks #}
{%- block email_widget -%}
  {%- set attr = attr|merge({'aria-describedby': ((attr['aria-describedby'] ?? '') ~ ' ' ~ id ~ '_client_error')|trim}) -%}
  {{- parent() -}}
  {{- block('client_error_slot') -}}
{%- endblock email_widget -%}

{# Form-level errors (e.g. an expired CSRF token) look like the flash alerts; field errors get the id the field points to #}
{%- block form_errors -%}
  {%- if errors|length > 0 -%}
    {%- if form is rootform -%}
      <twig:ui:Alert type="danger" id="{{ id }}_error" data-ps-ref="form-error">
        {%- for error in errors -%}
          <p>{{ error.message }}</p>
        {%- endfor -%}
      </twig:ui:Alert>
    {%- else -%}
      <div id="{{ id }}_error" class="invalid-feedback d-block">
        {%- for error in errors -%}
          <span class="d-block">{{ error.message }}</span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}
{%- endblock form_errors -%}

{# Every form button is a <twig:ui:Button> (DECISIONS.md #25); the page gives its look as form_widget variables:
 # form_widget(form.save, {variant: 'primary', icon: 'save'}). A submit button is primary unless told otherwise #}
{%- block button_widget -%}
  {%- if label is null or label == '' -%}
    {%- set label = label_format is not empty ? label_format|replace({'%name%': name, '%id%': id}) : (label is same as(false) ? '' : name|humanize) -%}
  {%- endif -%}
  {%- set text = translation_domain is same as(false) ? label : label|trans(label_translation_parameters, translation_domain) -%}
  {%- set buttonProps = attr|merge({
    id: id,
    name: full_name,
    type: type|default('button'),
    variant: variant ?? (type|default('button') == 'submit' ? 'primary' : 'secondary'),
    size: size ?? 'md',
    icon: icon ?? null,
    iconPosition: iconPosition ?? 'start',
    disabled: disabled,
  }) -%}
  <twig:ui:Button {{ ...buttonProps }}>{% if label_html is same as(false) %}{{ text }}{% else %}{{ text|raw }}{% endif %}</twig:ui:Button>
{%- endblock button_widget -%}

{%- block submit_widget -%}
  {%- set type = type|default('submit') -%}
  {{- block('button_widget') -}}
{%- endblock submit_widget -%}

{%- block reset_widget -%}
  {%- set type = type|default('reset') -%}
  {{- block('button_widget') -}}
{%- endblock reset_widget -%}

{# A text field named by its label, not by the "{id} input" aria-label the back office's global theme adds (it would
 # replace the label for screen readers); its suggestions (data_list) in a datalist #}
{%- block text_widget -%}
  {%- set suggestions = data_list ?? null -%}
  {%- if suggestions is not null -%}
    {%- set attr = attr|merge({list: id ~ '_datalist'}) -%}
  {%- endif -%}
  {{- block('form_widget_simple') -}}
  {%- if suggestions is not null -%}
    <datalist id="{{ id }}_datalist">
      {%- for suggestion in suggestions -%}<option value="{{ suggestion }}"></option>{%- endfor -%}
    </datalist>
  {%- endif -%}
{%- endblock text_widget -%}

{# A date: the browser's date field when the format is the one it sends (YYYY-MM-DD), text otherwise #}
{%- block date_picker_widget -%}
  {%- set type = date_format == 'YYYY-MM-DD' ? 'date' : 'text' -%}
  {{- block('form_widget_simple') -}}
{%- endblock date_picker_widget -%}

{# A range of two fields (a grid's filter of a column): a fieldset named by the column, each field by its own label, both
 # for screen readers only as the column header already shows them; small: Bootstrap's small fields. The field names
 # stay those of every theme #}
{%- block ps_filter_range -%}
  {%- set legend = label is same as(false) ? null : (label is empty ? name|humanize : (translation_domain is same as(false) ? label : label|trans(label_translation_parameters, translation_domain))) -%}
  <fieldset class="ps-filter-range" id="{{ id }}">
    {%- if legend -%}
      <legend class="visually-hidden">{{ legend }}</legend>
    {%- endif -%}
    {%- for field in fields -%}
      <div class="ps-filter-range__field">
        {{- form_label(field.child, field.label, {label_attr: {class: 'visually-hidden'}}) -}}
        {#- small: Bootstrap's small fields (a grid's filter row) -#}
        {%- if small ?? false -%}
          {{- form_widget(field.child, {attr: field.child.vars.attr|merge({class: ((field.child.vars.attr.class ?? '') ~ ' form-control-sm')|trim})}) -}}
        {%- else -%}
          {{- form_widget(field.child) -}}
        {%- endif -%}
      </div>
    {%- endfor -%}
    {%- if extra is defined and extra -%}
      {{- form_row(extra) -}}
    {%- endif -%}
  </fieldset>
{%- endblock ps_filter_range -%}

{%- block date_range_widget -%}
  {%- set fields = [{child: form.from, label: null}, {child: form.to, label: null}] -%}
  {%- set extra = form.unlimited ?? null -%}
  {{- block('ps_filter_range') -}}
{%- endblock date_range_widget -%}

{# Min and max are labelled by their placeholder ("Min", "Max") #}
{%- block integer_min_max_filter_widget -%}
  {%- set fields = [
    {child: form.min_field, label: form.min_field.vars.attr.placeholder ?? 'Min'|trans({}, 'Admin.Global')},
    {child: form.max_field, label: form.max_field.vars.attr.placeholder ?? 'Max'|trans({}, 'Admin.Global')},
  ] -%}
  {{- block('ps_filter_range') -}}
{%- endblock integer_min_max_filter_widget -%}

{%- block number_min_max_filter_widget -%}
  {{- block('integer_min_max_filter_widget') -}}
{%- endblock number_min_max_filter_widget -%}
