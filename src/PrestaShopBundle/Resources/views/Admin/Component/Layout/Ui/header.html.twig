{%- set employee = this.employee -%}
{%- set search = {
  action: legacy_path('AdminSearch'),
  query: this.searchQuery,
  type: this.searchType,
  types: [
    {value: 0, label: 'Everywhere'|trans({}, 'Admin.Navigation.Header'), placeholder: 'Products, orders, customers…'|trans({}, 'Admin.Navigation.Header')},
    {value: 1, label: 'Catalog'|trans({}, 'Admin.Global'), placeholder: 'Product name or reference'|trans({}, 'Admin.Navigation.Header')},
    {value: 2, label: 'Customers by name'|trans({}, 'Admin.Navigation.Header'), placeholder: 'Customer name'|trans({}, 'Admin.Navigation.Header')},
    {value: 6, label: 'Customers by IP address'|trans({}, 'Admin.Navigation.Header'), placeholder: '123.45.67.89'|trans({}, 'Admin.Navigation.Header')},
    {value: 3, label: 'Orders'|trans({}, 'Admin.Global'), placeholder: 'Order ID'|trans({}, 'Admin.Navigation.Header')},
    {value: 4, label: 'Invoices'|trans({}, 'Admin.Global'), placeholder: 'Invoice number'|trans({}, 'Admin.Navigation.Header')},
    {value: 5, label: 'Carts'|trans({}, 'Admin.Global'), placeholder: 'Cart ID'|trans({}, 'Admin.Navigation.Header')},
    {value: 7, label: 'Modules'|trans({}, 'Admin.Global'), placeholder: 'Module name'|trans({}, 'Admin.Navigation.Header')},
  ],
} -%}
{%- if employee -%}
  {%- set accountItems = [{label: 'Your profile'|trans({}, 'Admin.Navigation.Header'), href: path('admin_employees_edit', {employeeId: employee.id}), icon: 'person'}]
    |merge(this.employeeLinks)
    |merge([{type: 'divider'}, {label: 'Sign out'|trans({}, 'Admin.Navigation.Header'), href: path('admin_logout'), icon: 'logout'}]) -%}
{%- endif -%}
{%- set maintenanceDescription = 'Your shop is closed to visitors and customers. Turn maintenance mode off when you are ready.'|trans({}, 'Admin.Navigation.Notification')
  ~ (ps.frontOfficeAccessibleForAdmins|default(false) ? ' ' ~ 'Signed-in employees can still see it.'|trans({}, 'Admin.Navigation.Notification') : '') -%}
<twig:ui:Header homeUrl="{{ ps.defaultTabLink }}" logo="{{ asset('prestashop.svg', 'ui_kit') }}" version="{{ ps.version }}" :search="search">
  {%- if ps.debugMode|default(false) -%}
    <twig:ui:HeaderAction icon="bug_report" label="{{ 'Debug mode'|trans({}, 'Admin.Navigation.Header') }}" href="{{ url('admin_performance') }}" description="{{ 'All PHP errors and messages are shown. Turn debug mode off when you no longer need it.'|trans({}, 'Admin.Navigation.Notification') }}"/>
  {%- endif -%}
  {%- if ps.isMaintenanceEnabled|default(false) -%}
    <twig:ui:HeaderAction icon="build" label="{{ 'Maintenance mode'|trans({}, 'Admin.Navigation.Header') }}" href="{{ url('admin_maintenance') }}" description="{{ maintenanceDescription }}"/>
  {%- endif -%}
  <twig:ui:HeaderAction icon="storefront" label="{{ 'View my shop'|trans({}, 'Admin.Navigation.Header') }}" href="{{ ps.baseUrl }}" external/>
  {%- if employee -%}
    <twig:ui:HeaderAction image="{{ employee.imageUrl }}" label="{{ employee.firstName }} {{ employee.lastName }}" :items="accountItems"/>
  {%- endif -%}
  {{- renderhook('displayBackOfficeTop') -}}
</twig:ui:Header>
