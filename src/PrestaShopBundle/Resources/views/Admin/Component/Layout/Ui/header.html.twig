{#- Read here: in the blocks below, this is <twig:ui:Header> -#}
{%- set searchQuery = this.searchQuery -%}
{%- set searchType = this.searchType -%}

{%- set searchTypes = [
  {value: 0, icon: 'all_inclusive', label: 'Everywhere'|trans({}, 'Admin.Navigation.Header'), placeholder: 'Products, orders, customers…'|trans({}, 'Admin.Navigation.Header')},
  {value: 1, icon: 'store', label: 'Catalog'|trans({}, 'Admin.Global'), placeholder: 'Product name or reference'|trans({}, 'Admin.Navigation.Header')},
  {value: 2, icon: 'group', label: 'Customers by name'|trans({}, 'Admin.Navigation.Header'), placeholder: 'Customer name'|trans({}, 'Admin.Navigation.Header')},
  {value: 6, icon: 'desktop_mac', label: 'Customers by IP address'|trans({}, 'Admin.Navigation.Header'), placeholder: '123.45.67.89'|trans({}, 'Admin.Navigation.Header')},
  {value: 3, icon: 'shopping_basket', label: 'Orders'|trans({}, 'Admin.Global'), placeholder: 'Order ID'|trans({}, 'Admin.Navigation.Header')},
  {value: 4, icon: 'book', label: 'Invoices'|trans({}, 'Admin.Global'), placeholder: 'Invoice number'|trans({}, 'Admin.Navigation.Header')},
  {value: 5, icon: 'shopping_cart', label: 'Carts'|trans({}, 'Admin.Global'), placeholder: 'Cart ID'|trans({}, 'Admin.Navigation.Header')},
  {value: 7, icon: 'extension', label: 'Modules'|trans({}, 'Admin.Global'), placeholder: 'Module name'|trans({}, 'Admin.Navigation.Header')},
] -%}

{%- set maintenanceDescription = 'Your shop is closed to visitors and customers. Turn maintenance mode off when you are ready.'|trans({}, 'Admin.Navigation.Notification')
  ~ (ps.frontOfficeAccessibleForAdmins|default(false) ? ' ' ~ 'Signed-in employees can still see it.'|trans({}, 'Admin.Navigation.Notification') : '') -%}

{#- The shop state: the modes that are on, each a link to where it is turned off and what it means -#}
{%- set shopStateItems = [] -%}

{%- if ps.debugMode|default(false) -%}
  {%- set shopStateItems = shopStateItems|merge([
    {label: 'Debug mode'|trans({}, 'Admin.Navigation.Header'), href: url('admin_performance'), icon: 'bug_report'},
    {type: 'text', label: 'All PHP errors and messages are shown. Turn debug mode off when you no longer need it.'|trans({}, 'Admin.Navigation.Notification')},
  ]) -%}
{%- endif -%}

{%- if ps.isMaintenanceEnabled|default(false) -%}
  {%- set shopStateItems = shopStateItems|merge(shopStateItems is empty ? [] : [{type: 'divider'}])|merge([
    {label: 'Maintenance mode'|trans({}, 'Admin.Navigation.Header'), href: url('admin_maintenance'), icon: 'build'},
    {type: 'text', label: maintenanceDescription},
  ]) -%}
{%- endif -%}

<twig:ui:Header homeUrl="{{ ps.defaultTabLink }}" logo="{{ asset('prestashop.svg', 'ui_kit') }}">
  <twig:block name="search">
    <twig:ui:HeaderSearch action="{{ legacy_path('AdminSearch') }}" query="{{ searchQuery }}" :type="searchType" :types="searchTypes"/>
  </twig:block>

  <twig:block name="actions">
    {#- Modules are called here (displayBackOfficeTop), first, in a box that does not count in the layout; its old
     # classes are kept for modules that add their entries by script -#}
    <div class="ps-header__modules header-list component" data-ps-ref="header-modules">
      {{- renderhook('displayBackOfficeTop') -}}
    </div>

    {#- Icon only, so the bar keeps its room at every width: the shop state first, amber, while a mode is on -#}
    {%- if shopStateItems is not empty -%}
      <twig:ui:HeaderAction icon="warning" warning iconOnly :label="'Shop state'|trans({}, 'Admin.Navigation.Header')" :items="shopStateItems"/>
    {%- endif -%}

    {{- component('QuickAccess') -}}

    {{- component('NotificationsCenter') -}}

    {{- component('EmployeeDropdown') -}}
  </twig:block>
</twig:ui:Header>
