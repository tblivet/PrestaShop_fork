{% set classes = ['ps-alert', 'alert', 'alert-' ~ type] %}
{% if dismissible %}
  {% set classes = classes|merge(['alert-dismissible', 'fade', 'show']) %}
{% endif %}
{% if icon %}
  {% set classes = classes|merge(['d-flex', 'align-items-start', 'gap-2']) %}
{% endif %}
{# Only a danger alert interrupts screen readers; the others are announced politely #}
<div{{ attributes.defaults({class: classes|join(' '), role: type == 'danger' ? 'alert' : 'status'}) }}>
  {% if icon %}
    <twig:ui:Icon :name="icon" filled size="lg" class="ps-alert__icon"/>
    <div class="ps-alert__content">{% block content %}{% endblock %}</div>
  {% else %}
    {{ block('content') }}
  {% endif %}
  {% if dismissible %}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ 'Close'|trans({}, 'Admin.Actions') }}"></button>
  {% endif %}
</div>
