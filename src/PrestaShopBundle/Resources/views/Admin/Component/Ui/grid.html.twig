{#- A list page's grid (ui/.ai/designs/grid.md): a named section, the header (title and count), the toolbar (Search and
    Clear filters), the results summary the links land on, the table with its sort links and filter row, the pages -#}
{%- form_theme grid.filter_form '@PrestaShop/Admin/TwigTemplateForm/ui_kit_layout.html.twig' -%}

{%- set id = grid.id -%}
{%- set state = this.state -%}
{%- set titleId = id ~ '_grid_title' -%}
{%- set captionId = id ~ '_grid_caption' -%}
{%- set resultsId = id ~ '_grid_results' -%}
{%- set formId = id ~ '_filter_form' -%}
{%- set rowHeaderColumnId = this.rowHeaderColumnId -%}
{%- set previewColumnId = this.previewColumnId -%}
{%- set searchAndReset = this.searchAndReset -%}
{%- set hasFilters = this.hasFilters -%}
{%- set bulkItems = this.bulkItems -%}
{%- set gridItems = this.gridItems -%}
{%- set reorder = this.reorder -%}
{%- set reorderField = this.reorderField -%}
{%- set rowCount = grid.data.records|length -%}
{%- set paginated = grid.data.records_total > 10 or grid.pagination.offset > 0 -%}
{%- set showName = grid.view_options.display_name ?? true -%}
{%- set alignments = {right: 'end', center: 'center'} -%}
{%- set total = grid.data.records_total -%}
{#- The count for screen readers: "1 result", "1234 results" -#}
{%- set resultsWord = 1 == total ? 'result'|trans({}, 'Admin.Global') : 'results'|trans({}, 'Admin.Global') -%}

{%- set before -%}{%- block before %}{% endblock -%}{%- endset -%}
{%- set toolbar -%}{%- block toolbar %}{% endblock -%}{%- endset -%}
{%- set empty -%}{%- block empty %}{% endblock -%}{%- endset -%}
{%- set footer -%}{%- block footer %}{% endblock -%}{%- endset -%}

{#- Clear filters: grid-filters.js posts the reset and comes back to the results, or says it failed -#}
{%- set clearFilters = searchAndReset and searchAndReset.vars.show_reset_button ? {
  variant: 'link',
  'data-ps-action': 'grid-reset-filters',
  'data-ps-data-url': searchAndReset.vars.reset_url,
  'data-ps-data-redirect': searchAndReset.vars.redirect_url,
  'data-ps-data-fragment': resultsId,
  'data-ps-data-error': 'The filters could not be cleared. Try again.'|trans({}, 'Admin.Notifications.Error'),
} : null -%}

<section{{ attributes.defaults({
  id: id ~ '_grid_panel',
  class: 'ps-grid' ~ (embedded ? ' ps-grid--embedded' : ' card'),
  'data-ps-ref': 'grid',
  'data-ps-data-grid-id': id,
  'aria-labelledby': titleId,
}) }}>
  {#- The title names the section; embedded or display_name false, for screen readers only. The header band holds the
      title and the list's actions (export, refresh, SQL query): none without either -#}
  {%- if embedded or (showName is same as(false) and gridItems is empty) -%}
    <h{{ headingLevel }} id="{{ titleId }}" class="visually-hidden">{{ grid.name }}</h{{ headingLevel }}>
  {%- else -%}
    <header class="ps-grid__header card-header">
      <h{{ headingLevel }} id="{{ titleId }}" class="ps-grid__title{{ showName is same as(false) ? ' visually-hidden' }}">
        {{- grid.name }} <twig:ui:Badge variant="secondary" pill>{{ total }}<span class="visually-hidden"> {{ resultsWord }}</span></twig:ui:Badge>
      </h{{ headingLevel }}>
      {%- if gridItems is not empty -%}
        {#- The toggle keeps the old grids' id -#}
        <div class="dropdown ps-grid__list-actions">
          <twig:ui:IconButton :id="id ~ '-grid-actions-button'" icon="settings" :label="'List actions'|trans({}, 'Admin.Global')" variant="link" data-bs-toggle="dropdown" aria-expanded="false"/>
          <twig:ui:DropdownMenu align="end" :items="gridItems"/>
        </div>
      {%- endif -%}
    </header>
  {%- endif -%}

  <div id="{{ id }}_grid" class="ps-grid__body{{ embedded ? '' : ' card-body' }}">
    {{- renderhook('displayAdminGridTableBefore', this.hookParams) -}}
    {{- before -}}

    {%- if 'empty' == state -%}
      {%- if empty|trim is not empty -%}
        {{- empty -}}
      {%- else -%}
        <twig:ui:EmptyState icon="inbox" :title="'No records found'|trans({}, 'Admin.Global')" :headingLevel="min(headingLevel + 1, 6)"/>
      {%- endif -%}
    {%- else -%}
      {%- if searchAndReset or bulkItems is not empty or reorder or toolbar|trim is not empty -%}
        <div class="ps-grid__toolbar">
          {#- The bulk menu, off until a row is checked, and what is checked: grid-selection.js keeps both up to date -#}
          {%- if bulkItems is not empty and 'list' == state -%}
            <div class="ps-grid__bulk">
              <twig:ui:Dropdown :label="'Bulk actions'|trans({}, 'Admin.Global')" :items="bulkItems" variant="outline-secondary" disabled data-ps-ref="grid-bulk-actions"/>
              <p class="ps-grid__selection" role="status" data-ps-ref="grid-selection-count" data-ps-data-none="{{ 'No rows selected'|trans({}, 'Admin.Global') }}" data-ps-data-some="{{ '%count% selected'|trans({}, 'Admin.Global') }}">{{ 'No rows selected'|trans({}, 'Admin.Global') }}</p>
            </div>
          {%- endif -%}
          {{- toolbar -}}
          {#- Rows move while the list is sorted by position: Rearrange sorts it so, Done goes back -#}
          {%- if reorder and 'list' == state -%}
            <twig:ui:Button variant="outline-secondary" :href="reorder.href" :icon="reorder.active ? 'check' : 'swap_vert'">
              {{- reorder.active ? 'Done'|trans({}, 'Admin.Actions') : 'Rearrange'|trans({}, 'Admin.Actions') -}}
            </twig:ui:Button>
          {%- endif -%}
          {%- if searchAndReset -%}
            <twig:ui:Layout:Cluster class="ps-grid__search">
              {#- Outside the form, named by it: Enter in a filter field submits with Search, the form's first button -#}
              <twig:ui:Button type="submit" variant="outline-primary" icon="search" :form="formId">{{ 'Search'|trans({}, 'Admin.Actions') }}</twig:ui:Button>
              {%- if clearFilters -%}
                <twig:ui:Button {{ ...clearFilters }}>{{ 'Clear filters'|trans({}, 'Admin.Actions') }}</twig:ui:Button>
              {%- endif -%}
            </twig:ui:Layout:Cluster>
          {%- endif -%}
        </div>
      {%- endif -%}

      {#- Where sorting, pages and filters land (#{id}_grid_results, load-focus.js); it describes the table -#}
      <p id="{{ resultsId }}" class="ps-grid__summary" tabindex="-1" data-ps-ref="grid-results">
        {%- if 'no-match' == state -%}
          {{ total }} {{ resultsWord }}
        {%- else -%}
          {%- set range = this.range -%}
          {{ '%from%–%to% of %total%'|trans({'%from%': range[0], '%to%': range[1], '%total%': total}, 'Admin.Global') }}
        {%- endif -%}
      </p>

      {{- form_start(grid.filter_form, {action: grid.filter_form.vars.action ~ '#' ~ resultsId, attr: {id: formId, class: 'ps-grid__form'}}) -}}
      {%- if searchAndReset -%}{%- do searchAndReset.setRendered -%}{%- endif -%}
      {%- if reorderField -%}{%- do reorderField.setRendered -%}{%- endif -%}
      <div class="ps-grid__scroll table-responsive ps-scroll-fade ps-scroll-fade--x" data-ps-action="scroll-fade" role="region" aria-label="{{ '%list% table'|trans({'%list%': grid.name}, 'Admin.Global') }}">
        <table id="{{ id }}_grid_table" class="ps-grid__table table" aria-describedby="{{ resultsId }}">
          <caption id="{{ captionId }}" class="visually-hidden">{{ grid.name }}</caption>
          <thead>
            <tr class="ps-grid__headings">
              {%- for column in grid.columns -%}
                {%- set sort = 'list' == state ? this.sortState(column.id) : null -%}
                {%- set align = alignments[column.options.alignment ?? ''] ?? null -%}
                <th scope="col" id="{{ id }}_col_{{ column.id }}" class="ps-grid__heading{{ column.type in ['bulk_action', 'position_handle'] ? ' ps-grid__heading--select' }}{{ align ? ' ps-grid__heading--' ~ align }}"{% if sort %} aria-sort="{{ sort }}"{% endif %}>
                  {%- if 'position_handle' == column.type -%}
                    <span class="visually-hidden">{{ 'Move'|trans({}, 'Admin.Actions') }}</span>
                  {%- elseif 'bulk_action' == column.type -%}
                    {%- if 'list' == state -%}
                      <twig:ui:Check
                        :label="'Select all %count% rows on this page'|trans({'%count%': rowCount}, 'Admin.Global')"
                        hideLabel
                        :id="id ~ '_grid_bulk_action_select_all'"
                        class="ps-grid__check"
                        data-ps-action="grid-select-all"
                      />
                    {%- endif -%}
                  {%- elseif this.isSortable(column) -%}
                    <a class="ps-grid__sort" href="{{ this.sortHref(column.id) }}">
                      {{- column.name -}}
                      <twig:ui:Icon :name="{ascending: 'arrow_upward', descending: 'arrow_downward'}[sort] ?? 'unfold_more'" class="ps-grid__sort-icon"/>
                    </a>
                  {%- else -%}
                    {{ column.name }}
                  {%- endif -%}
                </th>
              {%- endfor -%}
            </tr>
            {%- if hasFilters -%}
              <tr class="ps-grid__filters">
                {%- for column in grid.columns -%}
                  <td class="ps-grid__filter">
                    {%- for filter in this.filtersFor(column.id) -%}
                      {#- A range is a fieldset named by the column; a field gets its hidden label. Bootstrap's small fields -#}
                      {%- if filter.vars.compound -%}
                        {{- form_widget(filter, {label: column.name, small: true}) -}}
                      {%- else -%}
                        {%- set size = 'choice' in filter.vars.block_prefixes ? 'form-select-sm' : 'form-control-sm' -%}
                        {{- form_label(filter, column.name, {label_attr: {class: 'visually-hidden'}}) -}}
                        {{- form_widget(filter, {attr: filter.vars.attr|merge({class: ((filter.vars.attr.class ?? '') ~ ' ' ~ size)|trim})}) -}}
                      {%- endif -%}
                    {%- endfor -%}
                  </td>
                {%- endfor -%}
              </tr>
            {%- endif -%}
          </thead>
          <tbody>
            {%- if 'list' == state -%}
              {%- for record in grid.data.records -%}
                {%- set rowIndex = loop.index -%}
                {%- set rowHeaderId = id ~ '_grid_rowhead_' ~ rowIndex -%}
                {#- A click on a clickable cell follows the row's link (grid-row-link.js); the keyboard has the link itself -#}
                {%- set rowLink = this.rowLink(record) -%}
                <tr class="ps-grid__row"{% if rowLink %} data-ps-action="grid-row-link" data-ps-data-href="{{ rowLink }}"{% endif %}>
                  {%- for column in grid.columns -%}
                    {%- set isRowHeader = column.id == rowHeaderColumnId -%}
                    {%- set tag = isRowHeader ? 'th' : 'td' -%}
                    {%- set align = alignments[column.options.alignment ?? ''] ?? null -%}
                    {#- With the preview toggle in it, the row's name is its value only: the cell names it -#}
                    <{{ tag }}{% if isRowHeader %} scope="row"{% if column.id != previewColumnId %} id="{{ rowHeaderId }}"{% endif %}{% endif %} class="ps-grid__cell ps-grid__cell--{{ column.type|replace({'_': '-'}) }}{{ align ? ' ps-grid__cell--' ~ align }}{{ rowLink and (column.options.clickable ?? false) ? ' ps-grid__cell--clickable' }}">
                      {{- include([
                        '@PrestaShop/Admin/Component/Ui/Grid/cell/' ~ id ~ '_' ~ column.id ~ '_' ~ column.type ~ '.html.twig',
                        '@PrestaShop/Admin/Component/Ui/Grid/cell/' ~ id ~ '_' ~ column.type ~ '.html.twig',
                        '@PrestaShop/Admin/Component/Ui/Grid/cell/' ~ column.type ~ '.html.twig',
                        '@PrestaShop/Admin/Component/Ui/Grid/cell/_fallback.html.twig',
                      ], {record: record, column: column, grid: grid, rowHeaderId: rowHeaderId, rowIndex: rowIndex, component: this}) -}}
                    </{{ tag }}>
                  {%- endfor -%}
                </tr>
                {%- if previewColumnId -%}
                  {#- Filled on the first open (grid-preview.js) -#}
                  <tr id="{{ id }}_grid_preview_{{ loop.index }}" class="ps-grid__preview" hidden data-ps-ref="grid-preview">
                    <td colspan="{{ grid.columns|length }}"><div class="ps-grid__preview-content" data-ps-target="grid-preview-content"></div></td>
                  </tr>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </tbody>
        </table>
      </div>
      {#- With a row's header, names its check: "Select 1024" -#}
      <span id="{{ id }}_grid_select_label" hidden>{{ 'Select'|trans({}, 'Admin.Actions') }}</span>
      {#- Under the table, not in it: a row of a table that scrolls sideways would put it out of sight on a phone -#}
      {%- if 'no-match' == state -%}
        {%- set clearFiltersHere = clearFilters ? clearFilters|merge({variant: 'outline-secondary'}) : null -%}
        <twig:ui:EmptyState class="ps-grid__no-match" size="sm" icon="search_off" :title="'No results match these filters'|trans({}, 'Admin.Global')" :headingLevel="min(headingLevel + 1, 6)">
          <twig:block name="actions">
            {%- if clearFiltersHere -%}
              <twig:ui:Button {{ ...clearFiltersHere }}>{{ 'Clear filters'|trans({}, 'Admin.Actions') }}</twig:ui:Button>
            {%- endif -%}
          </twig:block>
        </twig:ui:EmptyState>
      {%- endif -%}
      {{- form_end(grid.filter_form) -}}
      {#- What a row's submit action, a choice and a move send (form, formaction, _method; positions[] from
          grid-position.js): outside the filter form, so its fields do not go -#}
      <form id="{{ id }}_grid_action_form" method="post" hidden data-ps-ref="grid-action-form"></form>
    {%- endif -%}

    {{- renderhook('displayAdminGridTableAfter', this.hookParams) -}}
  </div>

  {%- if ('empty' != state and paginated) or footer|trim is not empty -%}
    <footer class="ps-grid__footer{{ embedded ? '' : ' card-footer' }}">
      {%- if 'empty' != state and paginated -%}
        {#- Read here: inside the layout below, this is the layout. A field to go to a page past five pages: for the first
            ones the links do -#}
        {%- set pages = {current: this.currentPage, links: this.pageLinks, jumpUrl: this.pageCount > 5 ? this.jumpUrl : null, perPage: this.pageCount > 5 ? this.limit : null} -%}
        {%- set limit = this.limit -%}
        {%- set limitItems = this.limitItems -%}
        <twig:ui:Layout:Cluster justify="between">
          <twig:ui:Pagination
            class="ps-grid__pagination"
            :current="pages.current"
            :links="pages.links"
            :label="'Pages of %list%'|trans({'%list%': grid.name}, 'Admin.Global')"
            :jumpUrl="pages.jumpUrl"
            :perPage="pages.perPage"
          />
          <twig:ui:Dropdown
            :label="'%limit% per page'|trans({'%limit%': limit}, 'Admin.Global')"
            :items="limitItems"
            variant="outline-secondary"
            size="sm"
            direction="up"
            align="end"
          />
        </twig:ui:Layout:Cluster>
      {%- endif -%}
      {{- footer -}}
    </footer>
  {%- endif -%}

  {#- The list's query, shown and sent to the SQL Manager as a new request named after the list -#}
  {%- if this.hasQueryModal -%}
    {#- Set here: inside the modal, id is the modal's -#}
    {%- set queryFormId = id ~ '_common_show_query_modal_form' -%}
    {%- set queryFieldId = id ~ '_grid_query' -%}
    <twig:ui:Modal :id="id ~ '_grid_common_show_query_modal'" :title="'SQL query'|trans({}, 'Admin.Global')" size="lg">
      <form id="{{ queryFormId }}" class="ps-grid__query" method="post" action="{{ path('admin_sql_requests_create') }}">
        <label class="form-label" for="{{ queryFieldId }}">{{ 'SQL query'|trans({}, 'Admin.Global') }}</label>
        <textarea class="form-control ps-grid__query-text" id="{{ queryFieldId }}" name="sql" rows="10" readonly>{{ grid.data.query }}</textarea>
        <input type="hidden" name="name" value="{{ grid.name }}">
      </form>
      <twig:block name="footer">
        <twig:ui:Button variant="link" data-bs-dismiss="modal">{{ 'Cancel'|trans({}, 'Admin.Actions') }}</twig:ui:Button>
        <twig:ui:Button type="submit" :form="queryFormId">{{ 'Export to SQL Manager'|trans({}, 'Admin.Actions') }}</twig:ui:Button>
      </twig:block>
    </twig:ui:Modal>
  {%- endif -%}
</section>
