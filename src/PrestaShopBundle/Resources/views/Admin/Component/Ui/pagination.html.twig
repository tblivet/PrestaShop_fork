{#- Previous, the page shown, Next: with jumpUrl, the page shown is a field to go to any page ("Page [3] of 25 Go"),
    without it the text "Page 3 of 25". On the first and the last page, the arrow that leads nowhere stays in place,
    disabled, out of reach and hidden from screen readers, so the bar never moves -#}
{%- if links|length > 1 -%}
  {%- set last = this.last -%}
  <nav{{ attributes.defaults({class: 'ps-pagination', 'aria-label': label}) }}>
    <ul class="pagination">
      {%- if links[current - 1] is defined -%}
        <li class="page-item ps-pagination__item ps-pagination__item--step">
          <a class="page-link ps-pagination__link" href="{{ links[current - 1] }}" rel="prev"><twig:ui:Icon name="chevron_left" flipRtl/><span class="visually-hidden">{{ 'Previous'|trans({}, 'Admin.Global') }}</span></a>
        </li>
      {%- else -%}
        <li class="page-item disabled ps-pagination__item ps-pagination__item--step" aria-hidden="true"><span class="page-link ps-pagination__link"><twig:ui:Icon name="chevron_left" flipRtl/></span></li>
      {%- endif -%}

      <li class="ps-pagination__item ps-pagination__item--position">
        {%- if jumpUrl -%}
          {#- The field inside its label: its name reads "Page 12 of 25"; pagination-jump.js goes to the page typed, or puts
              the current one back and announces the invalid message (novalidate: the pattern only says digits are
              expected) -#}
          <form class="ps-pagination__jump" data-ps-action="pagination-jump" data-ps-data-url="{{ jumpUrl }}" data-ps-data-last="{{ last }}" data-ps-data-invalid-message="{{ 'Enter a page number from 1 to %last%'|trans({'%last%': last}, 'Admin.Global') }}"{% if perPage %} data-ps-data-per-page="{{ perPage }}"{% endif %} novalidate>
            {#- One string for the whole label, so a language can put the field where it reads: the field goes where
                %current% is -#}
            {%- set around = 'Page %current% of %total%'|trans({'%current%': '%field%', '%total%': last}, 'Admin.Global')|split('%field%', 2) -%}
            <label class="ps-pagination__jump-field">{{ around[0] }}<input class="form-control form-control-sm ps-pagination__jump-input" type="text" inputmode="numeric" pattern="[0-9]*" name="page" value="{{ current }}" autocomplete="off">{{ around[1] ?? '' }}</label>
            <twig:ui:Button type="submit" variant="outline-secondary" size="sm">{{ 'Go'|trans({}, 'Admin.Actions') }}</twig:ui:Button>
          </form>
        {%- else -%}
          <span class="ps-pagination__position" aria-current="page">{{ 'Page %current% of %total%'|trans({'%current%': current, '%total%': last}, 'Admin.Global') }}</span>
        {%- endif -%}
      </li>

      {%- if links[current + 1] is defined -%}
        <li class="page-item ps-pagination__item ps-pagination__item--step">
          <a class="page-link ps-pagination__link" href="{{ links[current + 1] }}" rel="next"><span class="visually-hidden">{{ 'Next'|trans({}, 'Admin.Global') }}</span><twig:ui:Icon name="chevron_right" flipRtl/></a>
        </li>
      {%- else -%}
        <li class="page-item disabled ps-pagination__item ps-pagination__item--step" aria-hidden="true"><span class="page-link ps-pagination__link"><twig:ui:Icon name="chevron_right" flipRtl/></span></li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
