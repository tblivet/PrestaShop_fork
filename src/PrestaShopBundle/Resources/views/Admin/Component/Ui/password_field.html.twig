{# has-validation keeps the rounded corners right when a feedback message follows the group.
 # The button holds both icons; aria-pressed picks one (_password-field.scss), password-toggle.js only flips it. #}
<div{{ attributes.defaults({class: 'ps-password-field input-group has-validation'}) }}>
  {% block content %}{% endblock %}
  <button
    class="ps-password-field__toggle btn btn-primary d-inline-flex align-items-center justify-content-center"
    type="button"
    aria-label="{{ 'Show password'|trans({}, 'Admin.Actions') }}"
    aria-controls="{{ inputId }}"
    aria-pressed="false"
    data-ps-action="toggle-password"
  >
    <span class="ps-password-field__icon material-symbols-outlined fs-5 lh-1" aria-hidden="true">visibility</span>
    <span class="ps-password-field__icon ps-password-field__icon--shown material-symbols-outlined fs-5 lh-1" aria-hidden="true">visibility_off</span>
  </button>
</div>
