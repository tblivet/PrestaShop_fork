{# has-validation keeps the rounded corners right when a feedback message follows the group.
 # The button holds both icons; aria-pressed picks one (_password-field.scss), password-toggle.ts only flips it. #}
<div{{ attributes.defaults({class: 'ps-password-field input-group has-validation'}) }}>
  {% block content %}{% endblock %}

  <button
    class="ps-password-field__toggle btn btn-primary d-inline-flex align-items-center justify-content-center"
    type="button"
    aria-label="{{ label ? 'Show password: %label%'|trans({'%label%': label}, 'Admin.Actions') : 'Show password'|trans({}, 'Admin.Actions') }}"
    aria-controls="{{ inputId }}"
    aria-pressed="false"
    data-ps-action="toggle-password"
  >
    <twig:ui:Icon name="visibility" size="xl" class="ps-password-field__icon"/>
    <twig:ui:Icon name="visibility_off" size="xl" class="ps-password-field__icon ps-password-field__icon--shown"/>
  </button>
</div>
