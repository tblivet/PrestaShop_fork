{#- Search aliases: an inactive one struck through, said so -#}
{%- for alias in record[column.id] -%}
  {%- if alias.active -%}
    {{ alias.alias }}
  {%- else -%}
    <del>{{ alias.alias }}<span class="visually-hidden"> ({{ 'Disabled'|trans({}, 'Admin.Global') }})</span></del>
  {%- endif -%}
  {%- if not loop.last %}, {% endif -%}
{%- endfor -%}
