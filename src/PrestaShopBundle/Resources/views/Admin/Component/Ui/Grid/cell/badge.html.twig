{#- A badge of the column's type, of the record's, or of the record's colour (its text dark or light, to read on it) -#}
{%- set text = record[column.options.field] ?? null -%}
{%- set variants = ['primary', 'secondary', 'success', 'danger', 'warning', 'info', 'light', 'dark'] -%}
{%- set type = (column.options.badge_type ?? null) ?: (record[column.options.badge_type_field ?? ''] ?? null) -%}
{%- set color = record[column.options.color_field ?? ''] ?? null -%}
{%- if text is empty -%}
  {{- column.options.empty_value ?? '' -}}
{%- elseif type in variants -%}
  <twig:ui:Badge :variant="type">{{ text }}</twig:ui:Badge>
{%- elseif color -%}
  {#- The colour through a custom property (the kit's psk- prefix), the text dark or light by its WCAG contrast -#}
  <twig:ui:Badge variant="light" class="ps-grid__badge ps-grid__badge--ink-{{ component.inkOn(color) }}" style="--psk-grid-badge-color: {{ color }}">{{ text }}</twig:ui:Badge>
{%- else -%}
  {{- text -}}
{%- endif -%}
