{#- A link to the record; the old grids' button and colour templates are not kept: a link looks like one -#}
{%- set href = path(column.options.route, {(column.options.route_param_name): record[column.options.route_param_field], _fragment: column.options.route_fragment ?? null}) -%}
<a class="ps-grid__link" href="{{ href }}"{% if column.options.target ?? null %} target="{{ column.options.target }}"{% endif %}
  {%- for name, value in column.options.attr ?? {} -%}
    {%- if name != 'class' and value is not iterable and value is not formview %} {{ name }}="{{ value }}"{% endif -%}
  {%- endfor -%}
>
  {%- set icon = component.icon(column.options.icon ?? null) -%}
  {%- if icon -%}<twig:ui:Icon :name="icon"/> {% endif -%}
  {{- record[column.options.field] -}}
  {%- if (column.options.target ?? null) == '_blank' -%}
    <span class="visually-hidden"> {{ '(opens in a new tab)'|trans({}, 'Admin.Global') }}</span>
  {%- endif -%}
</a>
