{#- A row's actions (Grid::rowActions()) in one menu, its button described by the row's header, so "Actions" is heard
    with its order; the row itself opens its main one (grid-row-link.js). None that applies: an empty cell -#}
{%- set actions = component.rowActions(record, column) -%}
{%- if actions is not empty -%}
  <div class="dropdown ps-grid__actions">
    <twig:ui:IconButton icon="more_vert" :label="'Actions'|trans({}, 'Admin.Global')" variant="outline-secondary" size="sm" data-bs-toggle="dropdown" aria-expanded="false" :aria-describedby="rowHeaderId"/>
    <twig:ui:DropdownMenu align="end" :items="actions"/>
  </div>
{%- endif -%}
