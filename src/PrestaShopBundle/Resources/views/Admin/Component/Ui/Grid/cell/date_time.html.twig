{%- set value = record[column.id] ?? null -%}
{%- if value is empty or value == constant('PrestaShop\\PrestaShop\\Core\\Util\\DateTime\\DateTime::NULL_VALUE') -%}
  {{- column.options.empty_data ?? '' -}}
{%- else -%}
  {#- The shop's local date and time, as shown: no time zone offset -#}
  <time datetime="{{ value|date('Y-m-d\\TH:i:s') }}">{{ value|date(column.options.format) }}</time>
{%- endif -%}
