{#- A switch named by its column and its row ("Status 2"): grid-toggle.ts posts the change and says how it went. Without
    the right to change it (its route's AdminSecurity), the switch shows the value, disabled -#}
<twig:ui:Check
  type="switch"
  :label="column.name"
  hideLabel
  :checked="(record[column.options.field] ?? 0) == 1"
  :disabled="not component.canToggle(column)"
  :id="grid.id ~ '_grid_' ~ column.id ~ '_' ~ record[column.options.primary_field]"
  class="ps-grid__toggle"
  :aria-labelledby="grid.id ~ '_col_' ~ column.id ~ ' ' ~ rowHeaderId"
  data-ps-action="grid-toggle"
  :data-ps-data-url="component.toggleUrl(record, column)"
  :data-ps-data-error="'The change could not be saved. Try again.'|trans({}, 'Admin.Notifications.Error')"
/>
