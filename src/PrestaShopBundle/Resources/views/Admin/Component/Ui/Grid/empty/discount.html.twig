{#- Create discount opens the page's own modal, as the page head's button does -#}
<twig:ui:EmptyState icon="sell" :title="'No discount yet, create your first discount.'|trans({}, 'Admin.Catalog.Feature')" :headingLevel="headingLevel">
  <twig:block name="actions">
      <twig:ui:Button icon="add" data-bs-toggle="modal" data-bs-target="#createDiscountModal">{{ 'Create discount'|trans({}, 'Admin.Catalog.Feature') }}</twig:ui:Button>
  </twig:block>
</twig:ui:EmptyState>
