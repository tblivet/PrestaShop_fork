{#- A log's severity: its badge and, with_message, its word -#}
{%- set severity = record.severity -%}
{%- set levels = {
  0: {variant: 'secondary', message: 'Debug'},
  1: {variant: 'success', message: 'Informative only'},
  2: {variant: 'warning', message: 'Warning'},
  3: {variant: 'danger', message: 'Error'},
  4: {variant: 'dark', message: 'Major issue (crash)!'},
} -%}
{%- set level = levels[severity] ?? {variant: 'light', message: ''} -%}
<twig:ui:Badge :variant="level.variant" pill>
  {%- if column.options.with_message and level.message -%}
    {{ level.message|trans({}, 'Admin.Advparameters.Help') }} ({{ severity }})
  {%- else -%}
    {{ severity }}
  {%- endif -%}
</twig:ui:Badge>
