<twig:ui:EmptyState icon="attach_file" :title="'Upload files here'|trans({}, 'Admin.Catalog.Feature')" :headingLevel="headingLevel">
  {{ 'Make some files available to your customers and facilitate their purchasing environment by adding them just here! It can be instruction manuals, technical works or anything you want to attach to a product.'|trans({}, 'Admin.Catalog.Feature') }}
  <twig:block name="actions">
      <twig:ui:Button variant="outline-secondary" :href="documentation_link('attachment')" target="_blank">{{ 'Learn more'|trans({}, 'Admin.Actions') }}<span class="visually-hidden"> {{ '(opens in a new tab)'|trans({}, 'Admin.Global') }}</span></twig:ui:Button>
      <twig:ui:Button :href="path('admin_attachments_create')">{{ 'Add new file'|trans({}, 'Admin.Catalog.Feature') }}</twig:ui:Button>
  </twig:block>
</twig:ui:EmptyState>
