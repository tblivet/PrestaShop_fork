{%- set tag = href ? 'a' : 'div' -%}
{%- set root = {class: 'card ps-kpi ps-kpi--' ~ color, 'data-ps-ref': 'kpi'}
  |merge(href ? {href: href} : {})
  |merge(refreshUrl ? {'data-ps-data-refresh-url': refreshUrl} : {}) -%}

<{{ tag }}{{ attributes.defaults(root) }}>
  <div class="card-body ps-kpi__body">
    {%- if icon -%}
      <span class="ps-kpi__icon"><twig:ui:Icon :name="icon" size="lg"/></span>
    {%- endif -%}
    <div class="ps-kpi__text">
      <p class="ps-kpi__title">{{ title }}</p>
      {#- A value to refresh shows a placeholder, named for screen readers, until kpi.js sets it (a cached one may be out
          of date); none or blank, a long dash, named too -#}
      {%- set noValue = 'No value'|trans({}, 'Admin.Global') -%}
      {%- if refreshUrl -%}
        <p class="ps-kpi__value" data-ps-ref="kpi-value" data-ps-data-no-value="{{ noValue }}" aria-busy="true"><span class="placeholder-wave" aria-hidden="true"><span class="placeholder ps-kpi__placeholder"></span></span><span class="visually-hidden">{{ 'Loading...'|trans({}, 'Admin.Global') }}</span></p>
      {%- elseif value is null or value|trim is same as('') -%}
        <p class="ps-kpi__value" data-ps-ref="kpi-value"><span aria-hidden="true">—</span><span class="visually-hidden">{{ noValue }}</span></p>
      {%- else -%}
        <p class="ps-kpi__value" data-ps-ref="kpi-value">{{ value }}</p>
      {%- endif -%}
      {%- if subtitle -%}
        <p class="ps-kpi__subtitle">{{ subtitle }}</p>
      {%- endif -%}
    </div>
  </div>
</{{ tag }}>
