{%- set classes = 'dropdown-menu ps-dropdown-menu' ~ ('end' == align ? ' dropdown-menu-end') -%}
{#- popover: shown in the top layer, never cut by a box around it (dropdown-top-layer.ts) -#}

{%- if items is null -%}
  {#- Any markup (a form, text): a div, as a list may only hold items -#}
  <div{{ attributes.defaults({class: classes ~ ' ps-dropdown-menu--content', popover: 'manual'}) }}>
    {%- block content %}{% endblock -%}
  </div>
{%- else -%}
  <ul{{ attributes.defaults({class: classes, popover: 'manual'}) }}>
    {%- for item in items -%}
      <li>
        {%- if 'divider' == item.type -%}
          <hr class="dropdown-divider">
        {%- elseif 'heading' == item.type -%}
          <span class="dropdown-header">{{ item.label }}</span>
        {%- elseif 'text' == item.type -%}
          <span class="dropdown-item-text">{{ item.label }}</span>
        {%- else -%}
          {#- An item's own class joins the kit's: a second class attribute would be ignored -#}
          {%- set classes = 'dropdown-item ps-dropdown-menu__item' ~ (item.disabled and 'link' == item.type ? ' disabled') ~ (item.attr.class is defined ? ' ' ~ item.attr.class) -%}
          {%- set state = (item.active ? ' aria-current="true"') ~ (item.disabled and 'link' == item.type ? ' aria-disabled="true"') -%}
          {%- set extra -%}{% for name, value in item.attr|filter((value, name) => name != 'class') %} {{ name }}="{{ value }}"{% endfor %}{%- endset -%}

          {%- if 'link' == item.type -%}
            {#- A disabled link loses its href, like <twig:ui:Button> -#}
            <a class="{{ classes }}"{% if not item.disabled %} href="{{ item.href }}"{% else %} role="link"{% endif %}{{ state|raw }}{% if item.external %} target="_blank" rel="noopener noreferrer"{% endif %}{{ extra|raw }}>
          {%- else -%}
            {#- A submit item sends the form named by attr.form (its formaction, name and value with it) -#}
            <button type="{{ 'submit' == item.type ? 'submit' : 'button' }}" class="{{ classes }}"{{ state|raw }}{% if item.disabled %} disabled{% endif %}{{ extra|raw }}>
          {%- endif -%}

            {%- if item.icon -%}
              <twig:ui:Icon :name="item.icon" size="lg" class="ps-dropdown-menu__icon"/>
            {%- endif -%}

            <span class="ps-dropdown-menu__label">{{ item.label }}
              {%- if item.external %}<span class="visually-hidden"> {{ '(opens in a new tab)'|trans({}, 'Admin.Global') }}</span>{% endif -%}
            </span>

          {%- if 'link' == item.type -%}</a>{%- else -%}</button>{%- endif -%}
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
{%- endif -%}
