{% extends '@PrestaShop/Admin/Layout/Ui/login_layout.html.twig' %}

{% form_theme loginForm '@PrestaShop/Admin/TwigTemplateForm/ui_kit_layout.html.twig' %}
{% form_theme requestPasswordResetForm '@PrestaShop/Admin/TwigTemplateForm/ui_kit_layout.html.twig' %}

{% block login_title %}
  {{- showRequestPasswordResetForm ? requestPasswordResetForm.vars.label : 'Sign in to your back office'|trans({}, 'Admin.Login.Feature') -}}
{% endblock %}

{% block login_content %}
  {% set forgotPasswordLink = loginForm.stay_logged_in.vars.external_link %}

  {% set forgotEmail = requestPasswordResetForm.email_forgot %}
  {% set forgotIntroId = forgotEmail.vars.id ~ '_intro' %}

  {# submit-once: the kit marks the button busy and ignores a second submit (ui/src/js/components/submit-once.js) #}
  {{ form_start(loginForm, {action: path('admin_login'), attr: loginForm.vars.attr|merge({class: 'ps-login__form' ~ (showRequestPasswordResetForm ? ' d-none' : ''), 'data-ps-action': 'submit-once'})}) }}
    {# The panel header (title, messages), then the fields #}
    <twig:ui:Layout:Stack gap="lg">
      <twig:ui:Layout:Stack>
        <h1 class="ps-login__title" data-ps-ref="panel-title">{{ 'Sign in to your back office'|trans({}, 'Admin.Login.Feature') }}</h1>
        {% if not showRequestPasswordResetForm %}
          <twig:ui:FlashMessages/>
        {% endif %}
        {{ form_errors(loginForm) }}
      </twig:ui:Layout:Stack>

      <twig:ui:Layout:Stack>
        <div class="ps-login__form-group">
          {{ form_label(loginForm.email) }}
          {{ form_widget(loginForm.email, {attr: loginForm.email.vars.attr|merge({placeholder: 'name@example.com', autocomplete: 'email'})}) }}
          {{ form_errors(loginForm.email) }}
        </div>

        <div class="ps-login__form-group">
          {{ form_label(loginForm.passwd) }}
          {{ form_widget(loginForm.passwd, {attr: loginForm.passwd.vars.attr|merge({placeholder: loginForm.passwd.vars.label, autocomplete: 'current-password'})}) }}
          {{ form_errors(loginForm.passwd) }}
        </div>

        <div class="ps-login__form-group">
          {{ form_widget(loginForm.stay_logged_in) }}
        </div>

        {# Full width: the stack stretches it #}
        {{ form_widget(loginForm.submit_login, {variant: 'primary'}) }}

        <div class="ps-login__form-group text-end">
          {# A button: it switches panels in place, it does not navigate #}
          <twig:ui:Button
            variant="link"
            id="{{ forgotPasswordLink.attr.id }}"
            class="link-secondary small p-0"
            aria-controls="{{ requestPasswordResetForm.vars.attr.id }}"
            data-ps-action="{{ forgotPasswordLink.attr['data-ps-action'] }}"
          >{{ forgotPasswordLink.text }}</twig:ui:Button>
        </div>
      </twig:ui:Layout:Stack>
    </twig:ui:Layout:Stack>
  {{ form_end(loginForm) }}

  {{ form_start(requestPasswordResetForm, {action: path('admin_request_password_reset'), attr: requestPasswordResetForm.vars.attr|merge({class: 'ps-login__form' ~ (showRequestPasswordResetForm ? '' : ' d-none'), 'data-ps-action': 'submit-once'})}) }}
    <twig:ui:Layout:Stack gap="lg">
      <twig:ui:Layout:Stack>
        <h1 class="ps-login__title" data-ps-ref="panel-title">{{ requestPasswordResetForm.vars.label }}</h1>
        {% if showRequestPasswordResetForm %}
          <twig:ui:FlashMessages/>
        {% endif %}
        {{ form_errors(requestPasswordResetForm) }}

        <p class="ps-login__intro small text-body-secondary text-center" id="{{ forgotIntroId }}">
          {{- 'Enter your email address and we\'ll send you a link to reset your password.'|trans({}, 'Admin.Login.Feature') -}}
        </p>
      </twig:ui:Layout:Stack>

      <twig:ui:Layout:Stack>
        <div class="ps-login__form-group">
          {{ form_label(forgotEmail) }}
          {{ form_widget(forgotEmail, {attr: forgotEmail.vars.attr|merge({placeholder: 'name@example.com', autocomplete: 'email', 'aria-describedby': forgotIntroId, 'data-ps-ref': 'forgot-password-email'})}) }}
          {{ form_errors(forgotEmail) }}
        </div>

        {# Stacked on mobile in reading order, so the visual order and the focus order stay the same #}
        <twig:ui:Layout:Cluster justify="end" stackBelow="sm">
          {{ form_widget(requestPasswordResetForm.buttons.cancel) }}
          {{ form_widget(requestPasswordResetForm.buttons.submit_login, {variant: 'primary'}) }}
        </twig:ui:Layout:Cluster>
      </twig:ui:Layout:Stack>
    </twig:ui:Layout:Stack>
  {{ form_end(requestPasswordResetForm) }}
{% endblock %}
