{% extends '@PrestaShop/Admin/Layout/Ui/login_layout.html.twig' %}

{% block login_content %}
  <h1 class="ps-login__title">{{ 'Finish securing your shop'|trans({}, 'Admin.Login.Feature') }}</h1>
  <div class="d-grid gap-3">
    <twig:ui:Alert type="warning" icon="bi:exclamation-triangle-fill">
      <p>{{ 'For security reasons, do the following before you sign in:'|trans({}, 'Admin.Login.Notification') }}</p>
      <ul class="mb-0">
        {% for requiredAction in requiredActions %}
          <li>{{ requiredAction|raw_purified }}</li>
        {% endfor %}
      </ul>
    </twig:ui:Alert>
    {# Once the actions are done, the next step: this page again if one is left, the sign-in form otherwise #}
    <a class="btn btn-primary" href="{{ path('admin_login') }}">{{ 'Check again'|trans({}, 'Admin.Login.Feature') }}</a>
  </div>
{% endblock %}
