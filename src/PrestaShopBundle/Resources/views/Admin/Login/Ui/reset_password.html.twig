{% extends '@PrestaShop/Admin/Layout/Ui/login_layout.html.twig' %}

{% form_theme resetPasswordForm '@PrestaShop/Admin/TwigTemplateForm/ui_kit_layout.html.twig' %}

{% block login_javascripts %}
  <script src="{{ asset('themes/new-theme/public/reset_password.bundle.js') }}"></script>
{% endblock %}

{% block login_content %}
  {% set newPassword = resetPasswordForm.new_password %}
  {% set mismatchId = newPassword.second.vars.id ~ '_mismatch' %}
  {% set policyErrorId = newPassword.first.vars.id ~ '_policy' %}

  {{ form_start(resetPasswordForm, {attr: resetPasswordForm.vars.attr|merge({class: 'ps-login__form', 'data-ps-action': 'submit-once'})}) }}
    <h1 class="ps-login__title">{{ resetPasswordForm.vars.label }}</h1>
    <twig:ui:FlashMessages/>

    {{ form_errors(resetPasswordForm) }}

    {# The strength checklist, appended here by ChangePasswordHandler, replaces the field help #}
    <div class="ps-login__form-group" data-ps-ref="password-field">
      {{ form_label(newPassword.first) }}
      {{ form_widget(newPassword.first, {help: null, attr: newPassword.first.vars.attr|merge({
        autocomplete: 'new-password',
        'aria-describedby': policyErrorId,
      })}) }}
      {# Filled by reset-password.ts when a submit is blocked by the password policy #}
      <div class="invalid-feedback" id="{{ policyErrorId }}" role="status" data-ps-target="password-policy-error" data-ps-data-invalid="{{ 'Choose a password that meets the requirements.'|trans({}, 'Admin.Login.Notification') }}"></div>
      {{ form_errors(newPassword.first) }}
    </div>

    <div class="ps-login__form-group">
      {{ form_label(newPassword.second) }}
      {{ form_widget(newPassword.second, {attr: newPassword.second.vars.attr|merge({
        autocomplete: 'new-password',
        'aria-describedby': mismatchId,
      })}) }}
      {# Filled by reset-password.ts when the two passwords differ #}
      <div class="invalid-feedback" id="{{ mismatchId }}" role="status" data-ps-target="password-mismatch"></div>
      {{ form_errors(newPassword.second) }}
    </div>

    <div class="ps-login__form-group">
      {{ form_widget(resetPasswordForm.submit_login, {attr: resetPasswordForm.submit_login.vars.attr|merge({class: 'btn-primary w-100'})}) }}
    </div>

    <div class="ps-login__form-group text-end">
      <a class="btn btn-link link-secondary small p-0" href="{{ path('admin_login') }}">{{ 'Back to sign in'|trans({}, 'Admin.Login.Feature') }}</a>
    </div>
  {{ form_end(resetPasswordForm) }}

  {{ include('@PrestaShop/Admin/Helpers/password_feedback.html.twig') }}
{% endblock %}
