{% extends '@PrestaShop/Admin/Layout/Ui/login_layout.html.twig' %}

{% form_theme resetPasswordForm 'bootstrap_5_layout.html.twig' %}

{% block login_javascripts %}
  <script src="{{ asset('themes/new-theme/public/reset_password.bundle.js') }}"></script>
{% endblock %}

{% block login_content %}
  {% set newPassword = resetPasswordForm.new_password %}

  {{ form_start(resetPasswordForm, {attr: resetPasswordForm.vars.attr|merge({class: 'ps-login__form'})}) }}
    <h1 class="ps-login__title">{{ resetPasswordForm.vars.label }}</h1>
    {{ include('@PrestaShop/Admin/Layout/Ui/_flash_alerts.html.twig') }}

    {{ form_errors(resetPasswordForm) }}
    {{ form_errors(newPassword) }}

    {# The strength feedback is appended to each field group by ChangePasswordHandler #}
    <div class="ps-login__form-group">
      {{ form_label(newPassword.first) }}
      {{ form_widget(newPassword.first, {attr: newPassword.first.vars.attr|merge({autocomplete: 'new-password'})}) }}
      {{ form_help(newPassword.first) }}
      {{ form_errors(newPassword.first) }}
    </div>

    <div class="ps-login__form-group">
      {{ form_label(newPassword.second) }}
      {{ form_widget(newPassword.second, {attr: newPassword.second.vars.attr|merge({autocomplete: 'new-password'})}) }}
      {# Filled by reset-password.ts when the two passwords differ #}
      <div class="form-text d-none"></div>
      {{ form_errors(newPassword.second) }}
    </div>

    <div class="ps-login__form-group">
      {{ form_widget(resetPasswordForm.submit_login, {attr: {class: 'btn-primary ps-login__submit'}}) }}
    </div>
  {{ form_end(resetPasswordForm) }}

  {{ include('@PrestaShop/Admin/Helpers/password_feedback.html.twig') }}
{% endblock %}
